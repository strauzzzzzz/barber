# --- Только сервер (Vercel → Settings → Environment Variables). НЕ добавлять префикс VITE_ ---
GROQ_API_KEY=gsk_...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Фронтенд (публичные значения, нужны только для входа в /admin) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# --- Только для локальной разработки без Supabase/Groq ---
# DEMO_MODE=1     данные в памяти (seed), без Supabase
# GROQ_MOCK=1     скриптованный «бот» без ключа Groq
